<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AsyncPipeline</RootNamespace>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Version>1.0.0.0</Version>
    <Authors>Ian Robertson</Authors>
    <Product>Async Pipeline</Product>
    <Description>Build a flexible chained pipeline that can execute the steps asynchronously
</Description>
    <Copyright>Ian Robertson</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>Pipeline Asynchronous</PackageTags>
    <PackageId>Ian.Robertson.AsyncPipeline</PackageId>
    <PackageProjectUrl>https://github.com/silentbobbert/AsyncPipeline</PackageProjectUrl>
    <RepositoryUrl>https://github.com/silentbobbert/AsyncPipeline.git</RepositoryUrl>
    <RepositoryType>GIT</RepositoryType>
    <PackageReleaseNotes>1.0.0

- Retargeted to .NET 8.
- Replaced BlockingCollection/Task.Run pipeline implementation with System.Threading.Channels.
- Added support for async pipeline steps (ValueTask-based) and configurable per-step parallelism.
- Improved cancellation and disposal behavior (in-flight executions are canceled on dispose).
- Expanded unit test coverage (async steps, cancellation, concurrency, async exceptions).</PackageReleaseNotes>
  </PropertyGroup>

</Project>
